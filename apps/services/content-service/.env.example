# Content Service Environment Variables

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/content_db?schema=public"

# MongoDB Database (for drafts)
MONGODB_URL="mongodb://mongo:mongo@localhost:27017/content_drafts?authSource=admin"

# Redis Configuration
REDIS_URL="redis://:redis@localhost:6379"

# Server Configuration
PORT=3002
NODE_ENV="development"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Auth Service URL (for internal communication)
AUTH_SERVICE_URL="http://localhost:3001"

# Search Service URL (for indexing)
SEARCH_SERVICE_URL="http://localhost:3003"

# Cache TTL (in seconds)
CACHE_TTL_CONTENT=300
CACHE_TTL_LIST=60
