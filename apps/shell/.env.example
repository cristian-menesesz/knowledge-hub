# Shell Application Environment Variables

# Application
NODE_ENV=development
PORT=3000

# Remote Microfrontends (URLs)
# These will be configured when remote MFEs are deployed
CONTENT_READER_URL=http://localhost:3001
CONTENT_EDITOR_URL=http://localhost:3002
ADMIN_DASHBOARD_URL=http://localhost:3003

# API Gateway
API_GATEWAY_URL=http://localhost:8080

# Feature Flags
ENABLE_REMOTE_MODULES=false
